# Copy this file to .env.local and fill in your own key.
# .env.local is gitignored -- never commit real secrets.

# Powers the optional "background notes" feature (AI-generated context notes
# on the concept behind a guideline section). Get a key at
# https://build.nvidia.com (NVIDIA API catalog). Without this set, the
# feature shows a clear error instead of failing silently.
NVIDIA_API_KEY=

# Optional: override the model used for background notes. Default is a fast
# model (~1-90s per note observed). moonshotai/kimi-k3 also works and writes
# slightly richer notes, but is a much larger reasoning model that took
# 60s-2.5min per request in testing -- sometimes longer.
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
