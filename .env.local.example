# Copy this file to .env.local and fill in your own key.
# .env.local is gitignored -- never commit real secrets.

# Powers the optional "background notes" feature (AI-generated context notes
# on the concept behind a guideline section). Get a key at
# https://build.nvidia.com (NVIDIA API catalog). Without this set, the
# feature shows a clear error instead of failing silently.
NVIDIA_API_KEY=

# Optional: override the model used for background notes.
NVIDIA_MODEL=moonshotai/kimi-k3
